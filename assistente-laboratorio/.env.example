# Copiare in .env e completare. L'id del modello si legge con:
# (Invoke-RestMethod "http://localhost:1234/v1/models").data | Select-Object id
#
# Questo è solo un MODELLO della configurazione, senza segreti, e va su GitHub.
# Il file vero si chiama ".env", resta sul tuo PC e non va su GitHub.

# Dove risponde LM Studio (indirizzo e porta del suo server).
LM_BASE_URL=http://localhost:1234/v1
# L'id del modello caricato: va sostituito con quello restituito dal comando sopra
# (per esempio google/gemma-4-e2b).
LM_MODEL=ID_MODELLO_REALE
# Il fuso orario dello strumento orologio (nome IANA, per esempio Europe/Rome).
FUSO_ORARIO=Europe/Rome
# Facoltativa: quante volte al massimo il modello può essere chiamato per una domanda.
MAX_PASSI=5
# Facoltativa: quanto sono dettagliati i log (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=INFO

# Copiare in .env e completare. L'id del modello si legge con:
# (Invoke-RestMethod "http://localhost:1234/v1/models").data | Select-Object id
#
# Questo è solo un MODELLO della configurazione, senza segreti, e va su GitHub.
# Il file vero si chiama ".env", resta sul tuo PC e non va su GitHub.

# Dove risponde LM Studio (indirizzo e porta del suo server).
LM_BASE_URL=http://localhost:1234/v1
# L'id del modello caricato: va sostituito con quello restituito dal comando sopra
# (per esempio google/gemma-4-e2b).
LM_MODEL=ID_MODELLO_REALE
# Il fuso orario dello strumento orologio (nome IANA, per esempio Europe/Rome).
FUSO_ORARIO=Europe/Rome
# Argomenti di cui si occupa l'agente, separati da virgola: le domande fuori da questo ambito
# vengono rifiutate dal router. Saluti e conversazione sono sempre ammessi.
AMBITO_AGENTE=data e ora, calcoli, conversioni di unità, giorni lavorativi e scadenze, corsi del catalogo, note, meteo, concetti del corso (LLM, agenti, MCP)
# Facoltativa: quante volte al massimo il modello può essere chiamato in ogni tentativo di
# risposta dell'agente (dopo un rifiuto del revisore il conteggio riparte).
MAX_PASSI=5
# Facoltativa: volte massime in cui il revisore può rimandare la risposta all'agente in una domanda.
MAX_REVISIONI=2
# Facoltativa: numero di messaggi della conversazione oltre il quale i più vecchi vengono riassunti.
SOGLIA_RIASSUNTO=20
# Facoltativa: quanti messaggi recenti restano intatti dopo il riassunto (minore di SOGLIA_RIASSUNTO).
MESSAGGI_DA_TENERE=6
# Facoltativa: quanto sono dettagliati i log (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=INFO

# ---- Agente come servizio HTTP (lezione 6, step 6): tutte facoltative ----
# Facoltativa (la usa la CLI): indirizzo del servizio dell'agente.
AGENTE_URL=http://localhost:8000
# Facoltativa (la usa il servizio): interfaccia su cui ascolta; 127.0.0.1 = solo da questo PC
# (in Docker compose.yaml la imposta a 0.0.0.0).
AGENTE_HOST=127.0.0.1
# Facoltativa (la usa il servizio): porta del servizio (intero tra 1 e 65535).
AGENTE_PORTA=8000

# ---- Back-end (lezione 6, step 7) ----
# Obbligatorie: utente, password e nome del database PostgreSQL. Le usa il container db di
# compose.yaml (per creare il database al primo avvio) e il back-end (per collegarsi).
# Scegli una password tua al posto del segnaposto: il .env non va su GitHub.
POSTGRES_USER=laboratorio
POSTGRES_PASSWORD=CAMBIARE_PASSWORD
POSTGRES_DB=chat
# Facoltativa: dove risponde PostgreSQL (localhost = il container db sul tuo PC).
POSTGRES_HOST=localhost
# Facoltativa: porta di PostgreSQL sul PC (intero tra 1 e 65535). La usano il back-end e
# compose.yaml per pubblicare la porta del container db. Se sul PC è già installato un
# PostgreSQL che occupa la 5432, usare un'altra porta libera, per esempio 5433.
POSTGRES_PORTA=5432
# Facoltativa: interfaccia su cui ascolta il back-end; 127.0.0.1 = solo da questo PC.
BACKEND_HOST=127.0.0.1
# Facoltativa: porta del back-end (intero tra 1 e 65535; l'agente usa la 8000).
BACKEND_PORTA=8001
# Il back-end chiama l'agente all'indirizzo AGENTE_URL (vedi la sezione dello step 6).
